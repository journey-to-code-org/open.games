{
  "name": "@journey-to-code/decks",
  "version": "0.1.0",
  "description": "Card designs: what a deck looks like (its back, paper, inks and lettering), checked and turned into CSS variables.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/journey-to-code-org/open.games.git",
    "directory": "packages/decks"
  },
  "homepage": "https://github.com/journey-to-code-org/open.games#readme",
  "bugs": {
    "url": "https://github.com/journey-to-code-org/open.games/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}

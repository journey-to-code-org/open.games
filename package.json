{
  "name": "open.games",
  "private": true,
  "description": "Reusable game engine and kit for card, board and table-sport games, with computer players.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build -w @journey-to-code/rules -w @journey-to-code/physics -w @journey-to-code/decks -w @journey-to-code/palace -w @journey-to-code/games",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present"
  },
  "engines": {
    "node": ">=22.12"
  }
}
